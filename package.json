{
  "name": "captured",
  "productName": "Captured",
  "version": "1.0.1",
  "description": "Import video files from an SD card to your Mac.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "test": "node --test test/dates.test.js test/import.test.js",
    "preview": "node dev/build-preview.js && open dev/preview.html"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.captured.app",
    "productName": "Captured",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Captured",
      "artifactName": "Captured-${version}-universal.dmg",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      }
    },
    "afterPack": "build/after-pack.js"
  }
}
